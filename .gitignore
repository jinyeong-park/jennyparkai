case study


gitignore_content = """# ==========================================
# Common .gitignore Template
# ==========================================

# ------------------------------------------
# 1. Environment & Security (Sensitive Data)
# ------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
id_rsa
credentials.json
secrets.yml

# ------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------
# Node.js
node_modules/
jspm_packages/
.npm/

# Python
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class

# Java / Kotlin
.gradle/
build/
target/

# Flutter / Dart
.dart_tool/
.packages

# ------------------------------------------
# 3. Build & Output Files
# ------------------------------------------
dist/
out/
bin/
*.exe
*.dll
*.so
*.dylib
*.class
*.jar
*.war

# ------------------------------------------
# 4. IDE & OS Generated Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
desktop.ini

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / WebStorm
.idea/
*.iml
*.iws

# ------------------------------------------
# 5. Logs & Temporary Files
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.tmp
*.temp
*.swp
.cache/
"""

# Write to file
with open(".gitignore", "w", encoding="utf-8") as f:
    f.write(gitignore_content)

print("Created .gitignore file successfully.")